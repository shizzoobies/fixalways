---
const {
  title = "FixAlways",
  description = "Find top-rated home service pros in Florida.",
  badge = "Florida • Home Services",
} = Astro.props;

import { services } from "../data/services.js";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YZ4VDZW4J0"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-YZ4VDZW4J0');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/chat-widget.css" />
    <link rel="stylesheet" href="/styles/site-modal.css" />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>

  <body>
    <!-- Premium gradient accent bar -->
    <div class="accentBar"></div>

    <header class="siteHeader">
      <div class="headerInner">
        <a class="brandLink" href="/">
          <img src="/images/logo.png" alt="FixAlways" class="brandLogo" />
        </a>

        <nav class="headerNav">
          <a class="headerNavLink" href="/#services">Services</a>
          <a class="headerNavLink" href="/#cities">Cities</a>
        </nav>

        <div class="headerSearchWrap">
          <div class="headerSearchBar">
            <svg class="headerSearchIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <select id="topService" class="headerSearchSelect">
              <option value="hvac" selected>HVAC</option>
              <option value="plumbing">Plumbing</option>
              <option value="electrical">Electrical</option>
              <option value="roofing">Roofing</option>
              <option value="pest-control">Pest Control</option>
              <option value="handyman">Handyman</option>
            </select>
            <span class="headerSearchDivider"></span>
            <input id="topCity" class="headerSearchInput" type="text" placeholder="Enter city..." autocomplete="off" />
            <button id="topSearchBtn" class="headerSearchBtn" type="button" aria-label="Search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        </div>

        <button class="headerMobileToggle" id="mobileMenuToggle" type="button" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main class="siteMain">
      <slot />
    </main>

    <footer class="siteFooter">
      <div class="footerInner">
        <div class="footerLeft">
          <div class="footerLogo">
            <img src="/images/logo.png" alt="FixAlways" width="100" height="34" style="display: block;" />
          </div>
          <div class="footerMeta">&copy; {new Date().getFullYear()} FixAlways &middot; Florida Home Services</div>
        </div>
        <div class="footerLinks">
          <a class="footerLink" href="/#cities">Browse Cities</a>
          {services.map((s) => (
            <a class="footerLink" href={`/fl/tampa/${s.key}`}>{s.label}</a>
          ))}
        </div>
      </div>
    </footer>

    <script type="module" src="/js/top-search.js"></script>
    <script is:inline src="/js/chat-widget.js"></script>
    <script is:inline src="/js/site-modal.js"></script>
  </body>
</html>
